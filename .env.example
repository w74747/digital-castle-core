DB_HOST=localhost
DB_PORT=5432
DB_NAME=digital_castle
DB_USER=digital_castle_user
DB_PASSWORD=secure-password
APP_ENV=development
DEBUG=True
PORT=8000
LOG_LEVEL=DEBUG
LOG_DIR=logs
APP_SECRET_KEY=your-secret-key
JWT_SECRET=your-jwt-secret
JWT_ALGORITHM=HS256
STRIPE_API_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook
