# Digital Castle S.P.C - Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env file to Git!

# ===== Telegram Configuration =====
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_ID=your_telegram_admin_id_here

# ===== AI Provider API Keys =====
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
TOGETHER_API_KEY=your-together-api-key-here

# ===== GitHub Integration =====
GITHUB_TOKEN=ghp_your-github-personal-access-token-here
GITHUB_REPO=digital-castle-core
GITHUB_OWNER=your-github-username

# ===== Database =====
DATABASE_URL=postgresql://user:password@localhost:5432/digital_castle
DB_HOST=localhost
DB_PORT=5432
DB_NAME=digital_castle
DB_USER=digital_castle_user
DB_PASSWORD=secure-password-here

# ===== Application Configuration =====
APP_ENV=development
DEBUG=True
PORT=8000
LOG_LEVEL=DEBUG
LOG_DIR=logs

# ===== Security =====
APP_SECRET_KEY=your-secret-key-for-encryption-here
JWT_SECRET=your-jwt-secret-key-here
JWT_ALGORITHM=HS256

# ===== External Services =====
STRIPE_API_KEY=sk_test_your_stripe_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ===== Optional: Monitoring =====
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
PROMETHEUS_ENABLED=False

# ===== Optional: Email Notifications =====
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
NOTIFICATION_EMAIL=admin@digitalcastle.io

# ===== Optional: S3/Cloud Storage =====
AWS_ACCESS_KEY_ID=your-aws-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET=digital-castle-backups

# ===== Railway Specific =====
RAILWAY_ENVIRONMENT=production
RAILWAY_PUBLIC_DOMAIN=your-railway-domain.railway.app
