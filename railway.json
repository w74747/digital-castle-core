{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "dockerfile"
  },
  "deploy": {
    "startCommand": "python app.py",
    "restartPolicyType": "always",
    "restartPolicyMaxRetries": 5
  },
  "environment": [
    {
      "name": "TELEGRAM_BOT_TOKEN",
      "description": "رمز Telegram Bot API",
      "value": ""
    },
    {
      "name": "TELEGRAM_ADMIN_ID",
      "description": "معرف Telegram للمسؤول",
      "value": ""
    },
    {
      "name": "ANTHROPIC_API_KEY",
      "description": "مفتاح API لـ Anthropic (Claude)",
      "value": ""
    },
    {
      "name": "DEEPSEEK_API_KEY",
      "description": "مفتاح API لـ DeepSeek",
      "value": ""
    },
    {
      "name": "TOGETHER_API_KEY",
      "description": "مفتاح API لـ Together AI",
      "value": ""
    },
    {
      "name": "GITHUB_TOKEN",
      "description": "رمز الوصول إلى GitHub",
      "value": ""
    },
    {
      "name": "DATABASE_URL",
      "description": "رابط قاعدة البيانات",
      "value": "postgresql://"
    },
    {
      "name": "PORT",
      "description": "منفذ التطبيق",
      "value": "8000"
    },
    {
      "name": "WEBHOOK_URL",
      "description": "رابط webhook Telegram",
      "value": ""
    },
    {
      "name": "LOG_LEVEL",
      "description": "مستوى السجلات",
      "value": "INFO"
    }
  ]
}
